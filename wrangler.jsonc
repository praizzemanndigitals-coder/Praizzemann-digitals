{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "praizzemann-digitals",
  "main": "index.js",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "SITE_DATA",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ]
}
